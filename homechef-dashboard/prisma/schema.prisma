generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum OrderChannel {
  DIRECT
  FOODPANDA
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  address   String?
  createdAt DateTime @default(now())
  orders    Order[]
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  sortOrder Int        @default(0)
  menuItems MenuItem[]
}

model MenuItem {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Float
  costPrice   Float       @default(0)
  imageUrl    String?
  isAvailable Boolean     @default(true)
  stockQty    Int         @default(0)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  recipeLines       RecipeLine[] @relation("ItemRecipe")
  usedAsComponentIn RecipeLine[] @relation("ComboComponent")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Ingredient {
  id          String       @id @default(cuid())
  name        String       @unique
  unit        String
  costPerUnit Float
  recipeLines RecipeLine[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model RecipeLine {
  id              String      @id @default(cuid())
  menuItemId      String
  menuItem        MenuItem    @relation("ItemRecipe", fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredientId    String?
  ingredient      Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  componentItemId String?
  componentItem   MenuItem?   @relation("ComboComponent", fields: [componentItemId], references: [id], onDelete: Cascade)
  quantity        Float
}

model Order {
  id                  String       @id @default(cuid())
  customerId          String
  customer            Customer     @relation(fields: [customerId], references: [id])
  channel             OrderChannel @default(DIRECT)
  status              OrderStatus  @default(PENDING)
  deliveryAddress     String
  notes               String?
  totalAmount         Float
  costOverride        Float?
  platformCutOverride Float?
  externalId          String?      @unique
  items               OrderItem[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId  String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])
  quantity    Int
  priceAtSale Float
  costAtSale  Float    @default(0)
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  category    String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}
